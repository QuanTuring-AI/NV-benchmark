# Vol.5 · for a reader who runs the Blueprint's query path as Vol.5 did: the same settings as c4_n3.env (the file the
# measured runs used), with neutral container names (embed, rerank, nano) in place of that run's names. Nothing else
# differs. Deviation 2 (the answer model) and deviation 1 (the embedding model); the reranker as shipped.
APP_LLM_MODELNAME=nvidia/nemotron-3-nano
APP_LLM_SERVERURL=nano:8000
APP_EMBEDDINGS_MODELNAME=nvidia/nemotron-3-embed-1b
APP_EMBEDDINGS_SERVERURL=embed:8000/v1
APP_RANKING_MODELNAME=nvidia/llama-nemotron-rerank-1b-v2
APP_RANKING_SERVERURL=rerank:8000
