# Vol.5 · the RAG server's variables for reading the requests it sends to the answer model, with no card: every model
# service is capture_service.py (container p137_capture). Everything not named here is the Blueprint's default
# (BLUEPRINT_SETTINGS.md); the two model names are the volume's deviations 1 and 2.
APP_LLM_MODELNAME=nvidia/nemotron-3-nano
APP_LLM_SERVERURL=p137_capture:8000
APP_EMBEDDINGS_MODELNAME=nvidia/nemotron-3-embed-1b
APP_EMBEDDINGS_SERVERURL=p137_capture:8000/v1
APP_RANKING_SERVERURL=p137_capture:8000
