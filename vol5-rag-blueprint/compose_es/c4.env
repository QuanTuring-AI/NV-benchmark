# Vol.5 · cell C4: the RAG server's variables when all three model services are on the one card. Everything not named
# here is the Blueprint's default (BLUEPRINT_SETTINGS.md). The embedder and the reranker are the Blueprint's defaults
# (named so that the addresses point at this run's containers); the answer model is the volume's deviation 2.
APP_LLM_MODELNAME=nvidia/nemotron-3-nano
APP_LLM_SERVERURL=p137c4_llm:8000
APP_EMBEDDINGS_MODELNAME=nvidia/llama-nemotron-embed-vl-1b-v2
APP_EMBEDDINGS_SERVERURL=p137c4_embed:8000/v1
APP_RANKING_MODELNAME=nvidia/llama-nemotron-rerank-1b-v2
APP_RANKING_SERVERURL=p137c4_rank:8000
