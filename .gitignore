# Python / venv
.venv/
__pycache__/
*.pyc
*.egg-info/

# Secrets
.env

# OS
.DS_Store

# Claude Code
.claude/

# Internal docs (not for public repo)
# CLAUDE.md (public: red lines) and CLAUDE.local.md (internal) are a pair.
# Only the latter is excluded.
# After editing this block, run BOTH controls:
#   git check-ignore -v CLAUDE.local.md   -> must print one line  (positive)
#   git check-ignore -v CLAUDE.md         -> must print nothing   (negative)
# Verifying only one side fails silently.
CLAUDE.local.md
# (2026-09-14: the per-file entries that used to sit here were removed —
#  those drafts now live under _internal/, covered by the rule below.)

# Internal staging area (2026-09-13)
# Drafts and working notes that are not for publication live here.
# After editing this block, run BOTH controls:
#   git check-ignore -v _internal/x.md    -> must print one line  (positive)
#   git check-ignore -v README.md         -> must print nothing   (negative)
_internal/

# Debug scripts
benchmark/test_guardrails.py
benchmark/test_guardrails_debug.py

# Large data
chroma_db/
rag/knowledge/gtc_papers/*.pdf

# --- Defensive guards (2026-09-13, revised 2026-09-15) -----------------
# Weight and checkpoint files must never exist in this repo. Nothing here
# matches anything today; the entries are a guard, not a check.
# Guards that would name an excluded subject are NOT listed here: they live
# in .git/info/exclude (same effect, not versioned). That file does not
# travel with a clone, so the staged-content scanner refuses to run unless
# it finds the expected number of guard lines there.
*.safetensors
*.pt
*.pth
*.gguf
