# Python / venv
.venv/
__pycache__/
*.pyc
*.egg-info/

# Secrets
.env

# OS
.DS_Store

# Claude Code
.claude/

# Internal docs (not for public repo)
# CLAUDE.md (public: red lines) and CLAUDE.local.md (internal) are a pair.
# Only the latter is excluded.
# After editing this block, run BOTH controls:
#   git check-ignore -v CLAUDE.local.md   -> must print one line  (positive)
#   git check-ignore -v CLAUDE.md         -> must print nothing   (negative)
# Verifying only one side fails silently.
CLAUDE.local.md
# (2026-09-14: the per-file entries that used to sit here were removed —
#  those drafts now live under _internal/, covered by the rule below.)

# Internal staging area (2026-09-13)
# Drafts and working notes that are not for publication live here.
# After editing this block, run BOTH controls:
#   git check-ignore -v _internal/x.md    -> must print one line  (positive)
#   git check-ignore -v README.md         -> must print nothing   (negative)
_internal/

# Debug scripts
benchmark/test_guardrails.py
benchmark/test_guardrails_debug.py

# Large data
chroma_db/
rag/knowledge/gtc_papers/*.pdf

# --- Defensive guards (2026-09-13, revised 2026-09-15) -----------------
# Weight and checkpoint files must never exist in this repo. Nothing here
# matches anything today; the entries are a guard, not a check.
# Guards that would name an excluded subject are NOT listed here: they live
# in .git/info/exclude (same effect, not versioned). That file does not
# travel with a clone, so the staged-content scanner refuses to run unless
# it finds the expected number of guard lines there.
*.safetensors
*.pt
*.pth
*.gguf

# --- Process files (2026-09-16, P21 s5 / P23 s7) --------------------------
# Regenerated by re-running a harness; not evidence. They may contain free
# model output that cannot be reviewed line by line, so they stay local.
# Controls after editing (both must hold):
#   git check-ignore -v vol2-guardrails/results/bridge_2x2/c12/rows.jsonl    -> one line (positive)
#   git check-ignore -v vol2-guardrails/results/bridge_2x2/c12/analysis.json -> nothing  (negative)
**/logs/
**/counters/
**/harness_test/
rows.jsonl
*.partial.json
*.partial.jsonl
inputs.json
profile_export.jsonl
profile_export_raw.jsonl
*_console.txt
console.txt
*.stderr.txt
nim*.log.txt
*_startup.log.txt
*_stderr.txt
analyze.stdout.txt
pull_*.txt
first_request_discarded.*
container_cmdlines.txt
# full model answers collected as harness input (free text, regenerable from the run they came from)
vol2-guardrails/results/p28_judge_isolation/corpus.json

# Vol.2 P07 tool-call transcripts: every turn of every conversation (free model output)
vol3-nemotron/results/p07_toolcall/*.transcripts.jsonl
# Vol.2 P07 arm A1 probe: .requests[].content_head holds the model's own reasoning text
vol3-nemotron/results/p07_toolcall/probe_arm_a1.json
# Frozen pre-registrations held out of this repository. A pre-registration is never modified, so a file
# that cannot be published as it stands cannot be published at all. File names, digests, freeze times and
# the reason for each are disclosed in vol3-nemotron/README.md.
vol3-nemotron/results/s6/prediction_s6.json
vol3-nemotron/results/p07_toolcall/prediction_p07.json
vol3-nemotron/results/p07_toolcall/prediction_p07.sha256

# --- Process files (2026-09-26, P62 section 1) ---------------------------------
# Enumerated from the working tree and ruled by shape, not by file name.
# Controls after editing (both must hold):
#   git check-ignore -v vol1-nim/results/p59_nim_value/N-BF16_C_main/c0001/profile_export_aiperf.csv  -> one line (positive)
#   git check-ignore -v vol1-nim/results/p59_nim_value/N-BF16_C_main/c0001/profile_export_aiperf.json -> nothing  (negative)
# AIPerf's CSV copies of a level's summary and server metrics (the JSON beside each is kept)
profile_export_aiperf.csv
server_metrics_export.csv
# run-chain scripts, their console captures and stop flags, kept dot-named next to the results they produced
**/results/**/.*
# raw run events: they list the desktop processes holding a GPU context, with personal paths; events_public.jsonl is published
vol1-nim/results/*/events.jsonl
# answer-quality runs: full model output, lm-eval's logged samples, the proxy's records
vol1-nim/results/*/raw/
